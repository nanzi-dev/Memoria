# ============================================================================
# Memoria 环境变量模板
# 复制为 .env 后按需填写；.env 不要提交到版本库，也不要存放备用密钥。
# 与 src/memoria/core/config.py 保持同步。
# ============================================================================

# ====== 运行环境 ======
# development | production。production 会强制 AUTH_COOKIE_SECURE=true，
# 并关闭进程内旧 token 兼容回退。
MEMORIA_ENV=development

# ====== 大模型 API 配置（OpenAI 兼容接口） ======
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# Kimi (Moonshot) 示例：
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k
# Qwen (DashScope 兼容模式) 示例：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=400
SHORT_TERM_MEMORY_TURNS=8
LONG_TERM_MEMORY_INTERVAL_TURNS=5

# 辅助任务专用 LLM 配置（可选，留空则使用主 LLM 配置）
LLM_LIGHT_BASE_URL=
LLM_LIGHT_API_KEY=
LLM_LIGHT_MODEL=
LLM_LIGHT_TIMEOUT_SECONDS=12
LIGHT_TASK_MAX_OUTPUT_TOKENS=400

# ====== Speech 配置（可选，不配置则语音接口返回 503） ======
# TTS 默认 MiniMax 流式合成
SPEECH_TTS_PROVIDER=minimax
SPEECH_TTS_API_KEY=
SPEECH_TTS_BASE_URL=https://api.minimax.io/v1
SPEECH_TTS_MODEL=speech-2.8-turbo
SPEECH_TTS_TIMEOUT_SECONDS=30
SPEECH_TTS_MAX_RETRIES=1
SPEECH_TTS_DEFAULT_VOICE=female-shaonv
# 逗号分隔，供角色编辑器显示内置音色列表
SPEECH_TTS_BUILTIN_VOICES=male-qn-qingse,male-qn-jingying,male-qn-badao,male-qn-daxuesheng,female-shaonv,female-yujie,female-chengshu,female-tianmei

# STT 使用独立 OpenAI-compatible 端点
SPEECH_STT_PROVIDER=openai_compatible
SPEECH_STT_API_KEY=
SPEECH_STT_BASE_URL=https://api.openai.com/v1
SPEECH_STT_MODEL=gpt-4o-mini-transcribe
SPEECH_STT_TIMEOUT_SECONDS=30
SPEECH_STT_MAX_RETRIES=1

SPEECH_OUTPUT_FORMAT=mp3
SPEECH_STORAGE_PATH=./data/speech
SPEECH_STT_UPLOAD_MAX_BYTES=26214400
SPEECH_CUSTOM_VOICE_UPLOAD_MAX_BYTES=10485760
SPEECH_CACHE_MAX_AGE_SECONDS=604800
SPEECH_CACHE_MAX_BYTES=536870912

# 兼容旧部署（已弃用）：新的 TTS/STT 密钥为空时会回退到以下配置
SPEECH_PROVIDER=openai
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_TIMEOUT_SECONDS=30

# ====== 数据库 ======
# SQLite（零配置，适合本地开发）
DATABASE_PATH=./data/sqlite_db/memoria.db
# PostgreSQL（生产可选；留空则使用 SQLite）
# 示例: postgresql+psycopg://memoria:password@127.0.0.1:5432/memoria
DATABASE_URL=

# ====== 认证与安全 ======
# 本地 HTTP 开发保持 false；HTTPS/公网部署必须 true（MEMORIA_ENV=production 会强制）
AUTH_COOKIE_SECURE=false
# 可选：用于通过 API 创建唯一初始管理员的一次性引导令牌
ADMIN_BOOTSTRAP_TOKEN=

# ====== 限流与请求体 ======
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
# 必须大于最大单文件上传限制（STT 25MB、自定义语音/知识库 10MB）
MAX_REQUEST_BODY_BYTES=33554432

# ====== 世界时钟 ======
WORLD_CLOCK_DEFAULT_TIMEZONE=UTC
WORLD_CLOCK_SCHEDULER_INTERVAL_SECONDS=30
WORLD_CLOCK_SCHEDULER_LEASE_SECONDS=90

# ====== 记忆曲线 ======
MEMORIA_MEMORY_CURVE_ENABLED=true
MEMORIA_MEMORY_CURVE_MAX_STABILITY_DAYS=730
MEMORIA_MEMORY_CURVE_PERMANENT_THRESHOLD=0.95
MEMORIA_MEMORY_CURVE_CLARITY_CLEAR=0.65
MEMORIA_MEMORY_CURVE_CLARITY_FUZZY=0.35
MEMORIA_MEMORY_CURVE_CLARITY_FRAGMENT=0.15
MEMORIA_MEMORY_CURVE_RANK_WEIGHT_RELEVANCE=0.45
MEMORIA_MEMORY_CURVE_RANK_WEIGHT_RETENTION=0.35
MEMORIA_MEMORY_CURVE_RANK_WEIGHT_IMPORTANCE=0.20
MEMORIA_MEMORY_CURVE_FORGOTTEN_CLEANUP_DAYS=30

# ====== 关系增量策略 ======
MEMORIA_RELATIONSHIP_DELTA_ENABLED=true
MEMORIA_RELATIONSHIP_DELTA_MIN=0.0
MEMORIA_RELATIONSHIP_DELTA_MAX=10.0

# ====== 向量数据库 ======
VECTOR_DB_PATH=./data/chroma_db
# 本地路径或 HuggingFace 模型名
EMBEDDING_MODEL=./models/sentence-transformers/all-MiniLM-L6-v2
VECTOR_SEARCH_TOP_K=10

# ====== 世界观知识库 / RAG ======
KNOWLEDGE_STORAGE_PATH=./data/knowledge
KNOWLEDGE_QUERY_MAX_CHARS=4000
KNOWLEDGE_RETRIEVAL_TOP_K=4
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=3
KNOWLEDGE_SIMILARITY_THRESHOLD=0.60
KNOWLEDGE_INJECTION_MAX_CHARS=4000
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760
KNOWLEDGE_PDF_MAX_PAGES=300
KNOWLEDGE_EXTRACT_MAX_CHARS=1000000
KNOWLEDGE_CHUNK_TARGET_TOKENS=200
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=36
KNOWLEDGE_CHUNK_MAX_TOKENS=240

# 可选：当 EMBEDDING_MODEL 为 HuggingFace 远程模型时，固定 revision/tag 避免上游变更影响
EMBEDDING_MODEL_REVISION=
